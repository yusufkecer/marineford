# Dart / Flutter
.dart_tool/
.packages
build/
.flutter-plugins
.flutter-plugins-dependencies
plan.md
# Workspace members do not carry their own lockfile; the root one is committed.
packages/*/pubspec.lock
# tool/bridge_dump resolves on its own, outside the workspace, and its lock
# pins a local override nobody else has.
tool/*/pubspec.lock

# Generated
*.g.dart
*.marineford.dart
*.eval.dart
marineford_ids.json

# Patch artifacts
*.evc
*.mfp
out/

# Signing keys — NEVER commit these. `marineford init` adds them here too.
*.pem
*.key
marineford_private_key*
.marineford/secrets/

# Editors / OS
.idea/
.vscode/
*.iml
.DS_Store
Thumbs.db

# Compiled benchmark
bench/run
bench/run.exe

# A working copy of flutter_eval carrying the isAntiAlias fix, so the bridge
# dump and its round-trip test can run before that fix is published. Local by
# nature — see the dependency_overrides note in tool/bridge_dump/pubspec.yaml.
tool/bridge_dump/.flutter_eval_local/
